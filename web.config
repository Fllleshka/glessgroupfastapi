<?xml version="1.0" encoding="utf-8"?>
<!--
  GlessGroup API на IIS (Windows Server 2022), сайт glessapi.
  IIS сам запускает Python через HttpPlatformHandler и проксирует ему запросы.
  Порт передаётся в HTTP_PLATFORM_PORT — его читает main.py.

  Раскладка:
    E:\glessgroupfastapi\        клон репозитория, этот файл, main.py, .venv
    E:\glessgroupfastapi\logs\   журнал Python и приложения
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="GlessApiPython" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <rewrite>
      <rules>
        <!-- http → https. Включить (enabled="true") после выпуска сертификата.
             /.well-known/ исключена: через неё win-acme продлевает сертификат. -->
        <rule name="HttpsRedirect" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- Служебные файлы не отдаются ни при каких условиях -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".venv" />
          <add segment=".env" />
          <add segment="dates.py" />
          <add segment="databasedata" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpPlatform processPath="E:\glessgroupfastapi\.venv\Scripts\python.exe"
                  arguments="E:\glessgroupfastapi\main.py"
                  startupTimeLimit="60"
                  requestTimeout="00:01:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="E:\glessgroupfastapi\logs\python.log" />
  </system.webServer>

  <!-- Проверка домена Let's Encrypt (win-acme): эти файлы отдаёт сам IIS, а не Python -->
  <location path=".well-known">
    <system.webServer>
      <handlers>
        <clear />
        <add name="StaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
      </handlers>
      <staticContent>
        <mimeMap fileExtension="." mimeType="text/plain" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>